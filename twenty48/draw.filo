; The tiles in the colours of their worth, cooler to hotter; under the grid
; the score and how it goes, and the keys.
(def COLOURS (list 239 94 130 166 202 160 178 214 208 220 226 230))
; 2 is level 0, 4 level 1, ...
(def level (fn (v) (if (<= v 2) 0 (+ 1 (level (/ v 2))))))
(def centred-in (fn (text width) (let ((l (floor (/ (- width (text-width text)) 2)))) l)))

(let ((x0 (gx)) (y0 (gy)))
  (fg 214)
  (attr A_BOLD)
  (print-at (- y0 2) (floor (/ (- W 4) 2)) "2048")
  (attr 0)
  (map
    (fn (i)
      (let ((v (nth TILES i))
            (x (+ x0 (* (- i (* N (floor (/ i N)))) (+ CELL_W 1))))
            (y (+ y0 (* (floor (/ i N)) CELL_H))))
        (if (= v 0)
          (do (bg 235) (fill y x CELL_H CELL_W " ") (bg C_DEFAULT))
          (let ((c (nth COLOURS (math-min (- (length COLOURS) 1) (level v)))) (t (string v)))
            (bg c)
            (fg (if (>= (level v) 9) 0 231))
            (fill y x CELL_H CELL_W " ")
            (attr A_BOLD)
            (print-at (+ y 1) (+ x (centred-in t CELL_W)) t)
            (attr 0)
            (bg C_DEFAULT)))))
    (range (* N N)))
  (fg 250)
  (let ((stuck (not (can-move? TILES))))
    (if stuck (report) #t)
    (let ((say (cond (stuck (str-fmt "No moves left · score %d · r plays again" SCORE))
                     (WON (str-fmt "2048! score %d · keep going" SCORE))
                     (else (str-fmt "score %d" SCORE)))))
      (print-at (+ y0 GRID_H 1) (math-max 0 (floor (/ (- W (text-width say)) 2))) say)))
  (fg 244)
  (let ((keys "arrows slide · r new · esc leaves"))
    (keys-at (+ y0 GRID_H 2) keys))
  (fg C_DEFAULT))

; The sky moves on its own cadence, whatever slice the host ticks at; a
; backlog is dropped rather than banked, so a throttled tab does not come
; back and fall through a dozen rows at once.
(if (not (or over cramped))
  (do
    (set waited (+ waited MS))
    (if (>= waited STEP_MS)
      (do
        (set waited (- waited STEP_MS))
        (if (> waited STEP_MS) (set waited 0))
        (step)))))

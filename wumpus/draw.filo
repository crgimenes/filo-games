; The story so far, broken at the screen's width (a phone's too), the
; newest lines at the bottom; then the prompt; the arrows left on the title
; line.
(let ((width (math-min W 72))
      (left (math-max 0 (floor (/ (- W 72) 2))))
      (room (math-max 3 (math-min LOG_MAX (- H 5)))))
  (let ((lines (fold (fn (acc l) (list-concat acc (wrap l width))) (list) LOG))
        (top (math-max 0 (- H room 4))))
    (let ((shown (if (> (length lines) room) (map (fn (i) (nth lines (+ i (- (length lines) room)))) (range room)) lines)))
      (fg 214)
      (attr A_BOLD)
      (print-at top left "HUNT THE WUMPUS")
      (attr 0)
      (fg 244)
      (print-at top (+ left 17) (str-fmt "arrows %d" ARROWS))
      (fg 252)
      (map (fn (i) (print-at (+ top 2 i) left (nth shown i))) (range (length shown)))
      (fg 214)
      (print-at (+ top room 3) left ">")
      (fg 252)
      (input-at (+ top room 3) (+ left 2) (math-max 10 (- width 3)) 40 #f)
      (fg C_DEFAULT))))

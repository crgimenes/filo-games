; What the mode shows: the WOPR's question, the board (whose turn, the
; tally, the keys), the war, or the last words.
(cond
  ((= MODE "ask")
    (let ((y (math-max 1 (floor (/ (- H 8) 2)))))
      (fg 51)
      (attr A_BOLD)
      (centred y "SHALL WE PLAY A GAME?")
      (attr 0)
      (fg 250)
      (centred (+ y 2) "TIC-TAC-TOE")
      (centred (+ y 4) "HOW MANY PLAYERS?")
      (fg 214)
      (centred (+ y 5) "0 · 1 · 2")
      (fg 244)
      (keys-at (+ y 7) "0 1 2 choose · esc leaves")))
  ((or (= MODE "play") (= MODE "wopr"))
    (let ((x0 (gx)) (y0 (gy)) (w (winner B)))
      (fg 51)
      (attr A_BOLD)
      (centred (- y0 2) (if (= MODE "wopr") "WOPR · TIC-TAC-TOE" "TIC-TAC-TOE"))
      (attr 0)
      (fg 240)
      (map (fn (k) (print-at (+ y0 k) (+ x0 CELL_W) "│") (print-at (+ y0 k) (+ x0 (* 2 CELL_W) 1) "│")) (range GRID_H))
      (map (fn (r) (print-at (+ y0 (* r (+ CELL_H 1)) CELL_H) x0 "─────┼─────┼─────")) (range 2))
      (map
        (fn (i)
          (let ((r (floor (/ i 3))) (c (- i (* 3 (floor (/ i 3))))) (v (nth B i)))
            (let ((y (+ y0 (* r (+ CELL_H 1)))) (x (+ x0 (* c (+ CELL_W 1)))))
              (if (and (= MODE "play") (= i AT) (= w 0))
                (do (bg 238) (fill y x CELL_H CELL_W " ") (bg C_DEFAULT))
                #t)
              (if (= v 0)
                #t
                (do
                  (fg (if (= v 1) 214 51))
                  (attr A_BOLD)
                  (if (and (= MODE "play") (= i AT) (= w 0)) (bg 238) #t)
                  (print-at (+ y 1) (+ x 2) (if (= v 1) "X" "O"))
                  (bg C_DEFAULT)
                  (attr 0))))))
        (range 9))
      (fg 250)
      (let ((mark (fn (p) (if (= p 1) "X" "O"))))
        (centred (+ y0 GRID_H 1)
          (cond
            ((= MODE "wopr")
              (str-fmt "GAMES PLAYED %d · WINNER: %s" (+ GAMES (if (> w 0) 1 0))
                (cond ((> X_WINS 0) "X") ((> O_WINS 0) "O") (else "NONE"))))
            ((= w 3) "A draw.  space plays again")
            ((> w 0) (str-fmt "%s%s  space plays again" (mark w)
                       (if (= PLAYERS 1) (if (= w HUMAN) " — you win!" " — the machine wins.") " wins!")))
            ((= PLAYERS 2) (str-fmt "%s to move" (mark TURN)))
            ((= TURN HUMAN) (str-fmt "your move (%s)" (mark HUMAN)))
            (else "thinking…"))))
      (fg 244)
      (if (= MODE "play")
        (do
          (centred (+ y0 GRID_H 2) (str-fmt "X %d · O %d · draws %d" X_WINS O_WINS DRAWS))
          (keys-at (+ y0 GRID_H 3) "arrows move · space plays · 1-9 a square · r new · m players · esc leaves"))
        (keys-at (+ y0 GRID_H 3) "m players · esc leaves"))))
  ((= MODE "war") (draw-war))
  (else
    (let ((y (math-max 1 (floor (/ (- H (length LAST_WORDS)) 2))))
          (shown (floor (/ T TYPE_MS))))
      (fg 51)
      (attr A_BOLD)
      ; typed out a rune at a time, line after line
      (fold
        (fn (left i)
          (let ((line (nth LAST_WORDS i)))
            (let ((n (math-min (str-len line) (math-max 0 left))))
              (print-at (+ y i) (math-max 0 (floor (/ (- W (text-width line)) 2))) (str-sub line 0 n))
              (- left (+ (str-len line) 1)))))
        shown
        (range (length LAST_WORDS)))
      (attr 0)
      (fg 244)
      (keys-at (+ y (length LAST_WORDS) 2) "m players · esc leaves"))))
(fg C_DEFAULT)

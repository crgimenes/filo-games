; Time arrives in whatever slice the host ticks at; a frame is drawn when
; enough of it has piled up. A throttled tab must not bank frames and
; spin on return, so a backlog is dropped.
(if (not paused)
  (do
    (set waited (+ waited MS))
    (if (>= waited STEP_MS)
      (do
        (set waited (- waited STEP_MS))
        (if (> waited STEP_MS) (set waited 0))
        (turn-frame)
        (frame)))))

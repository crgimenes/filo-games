; Time passes in whole steps: MS arrives in whatever slice the host ticks
; at, and the snake moves when enough of them have piled up. A throttled tab
; must not bank steps and burst on return, so a backlog is dropped.
(if (not (or over cramped))
  (do
    (set waited (+ waited MS))
    (if (>= waited STEP_MS)
      (do
        (set waited (- waited STEP_MS))
        (if (> waited STEP_MS) (set waited 0))
        (set dir want)
        (step)))))

; Time arrives in whatever slice the host ticks at; a share of the pass is
; made when enough of it has piled up, and a backlog is dropped rather than
; banked.
(if (not paused)
  (do
    (set waited (+ waited MS))
    (if (>= waited STEP_MS)
      (do
        (set waited (- waited STEP_MS))
        (if (> waited STEP_MS) (set waited 0))
        (work)))))
